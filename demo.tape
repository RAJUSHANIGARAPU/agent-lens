# agent-lens demo recording
# Run from the repo root: vhs demo.tape  →  produces demo.gif
# Requires: pip install agentlens-tracer (or pip install -e .)

Output demo.gif

Set Theme Molokai
Set FontSize 18
Set Width 1200
Set Height 800
Set Padding 20
Set TypingSpeed 40ms

Type "python examples/07_demo_mock.py"
Enter
# examples/07_demo_mock.py measured at 46.0s wall time; Sleep is >= 1.25x that so the verdict is recorded.
Sleep 60s
